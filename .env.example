NODE_ENV=development
PORT=3000

# Supabase > Connect > Transaction pooler (puerto 6543)
DATABASE_URL="postgresql://postgres.REF_DEL_PROYECTO:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Supabase > Connect > Session pooler (puerto 5432), para migraciones
DIRECT_URL="postgresql://postgres.REF_DEL_PROYECTO:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Secreto aleatorio de al menos 32 caracteres
SESSION_SECRET="CAMBIAR_POR_UN_SECRETO_ALEATORIO"